# Copy to .env next to compose.yml and chmod 600 it. Never commit the real file.

# GitHub fine-grained token for the target repositories: Contents and Metadata read only.
UPW_GITHUB_TOKEN_TARGETS=
# GitHub fine-grained token for public upstream repositories: no repository access at all.
UPW_GITHUB_TOKEN_UPSTREAM=
# LLM provider API key, with the provider's minimum scope; may instead be set on the settings page.
UPW_LLM_API_KEY=
# Digest webhook URL; the URL itself is the secret, use one that can only post to the digest channel.
UPW_WEBHOOK_URL=
# SMTP password for the email notifier; use an app password limited to sending mail.
UPW_SMTP_PASSWORD=
# Image tag compose runs, for example v0.1.0; not a secret, and empty means latest.
UPW_VERSION=
# Time zone the container runs in; not a secret.
TZ=Europe/London
